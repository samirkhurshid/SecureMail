# ─────────────────────────────────────────────────────────────────
#  Email Security Gateway — Environment Configuration
#  Copy this to .env and fill in your keys.
#  NEVER commit .env to git. Add it to .gitignore.
# ─────────────────────────────────────────────────────────────────

# ── API Keys (server-side only — never exposed to frontend) ──────
# VirusTotal: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your_virustotal_key_here

# AbuseIPDB: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=your_abuseipdb_key_here

# Anthropic (for AI threat explanations): https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── App ───────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SCAN_TIMEOUT_SECONDS=30
MAX_ATTACHMENT_SIZE_MB=32

# ── Rate Limits ───────────────────────────────────────────────────
VT_REQUESTS_PER_MINUTE=4
ABUSEIPDB_REQUESTS_PER_DAY=1000

# ── Risk Thresholds ───────────────────────────────────────────────
VT_MALICIOUS_THRESHOLD=3
ABUSEIPDB_CONFIDENCE_THRESHOLD=25
RISK_SCORE_HIGH=70
RISK_SCORE_MEDIUM=40

# ── Forensics ─────────────────────────────────────────────────────
FORENSICS_LOG_DIR=./forensics_logs
FORENSICS_MAX_LOGS=10000

# ── CORS (comma-separated origins or * for all) ───────────────────
CORS_ALLOWED_ORIGINS=*
