# ─────────────────────────────────────────────────────────────────
#  Email Security Gateway — Environment Configuration
#  Copy this to .env and fill in your keys.
#  NEVER commit .env to git. Add it to .gitignore.
# ─────────────────────────────────────────────────────────────────

# ── API Keys (server-side only — never exposed to frontend) ──────
# VirusTotal: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your_virustotal_key_here

# AbuseIPDB: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=your_abuseipdb_key_here

# Anthropic (for AI threat explanations): https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── App ───────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SCAN_TIMEOUT_SECONDS=30
MAX_ATTACHMENT_SIZE_MB=32

# ── Rate Limits ───────────────────────────────────────────────────
VT_REQUESTS_PER_MINUTE=4
ABUSEIPDB_REQUESTS_PER_DAY=1000

# ── Risk Thresholds ───────────────────────────────────────────────
VT_MALICIOUS_THRESHOLD=3
ABUSEIPDB_CONFIDENCE_THRESHOLD=25
RISK_SCORE_HIGH=70
RISK_SCORE_MEDIUM=40

# ── Forensics ─────────────────────────────────────────────────────
FORENSICS_LOG_DIR=./forensics_logs
FORENSICS_MAX_LOGS=10000

# ── Authentication (Firebase Admin SDK) ────────────────────
# 1. Go to Firebase Console > Project Settings > Service Accounts
# 2. Click "Generate new private key" — downloads a JSON file
# 3. Save it as firebase-service-account.json in this Backend/ folder
# 4. NEVER commit this file — add it to .gitignore
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# ── CORS (comma-separated origins or * for all) ───────────────────
# Add your production frontend domain here before deploying, e.g. https://securemail.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Encryption (Required for session / login metadata at rest) ─────
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=

# ── Email Digest (Resend API) ─────────────────────────────────────
# Get free API key at: https://resend.com/api-keys
RESEND_API_KEY=
DIGEST_FROM_EMAIL=SecureMail <digest@yourdomain.com>



